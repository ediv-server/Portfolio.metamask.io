<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#08080b" />
<title>MetaMask — Transaction Database</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

<!-- Real MetaMask logo in the browser tab -->
<link rel="icon" type="image/png" sizes="32x32" href="https://metamask.io/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="https://metamask.io/favicon-16x16.png" />
<link rel="icon" href="https://metamask.io/favicon.ico" />
<link rel="apple-touch-icon" href="https://metamask.io/apple-touch-icon.png" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M29.2 4.1 17.8 12.6l2.1-5 9.3-3.5Z' fill='%23E2761B'/%3E%3Cpath d='M2.8 4.1 14.1 12.7l-2-5.1L2.8 4.1Z' fill='%23E4761B'/%3E%3Cpath d='M25.1 21.9l-3.1 4.8 6.7 1.8 1.9-6.5-5.5-.1ZM1.4 22l1.9 6.5 6.7-1.8-3.1-4.8-5.5.1Z' fill='%23E4761B'/%3E%3Cpath d='M17.5 17.3l.4-6.7 1.8-4.9h-8l1.8 4.9.4 6.7.2 2.1v5.4h2.8v-5.4l.6-2.1Z' fill='%23F6851B'/%3E%3C/svg%3E" />

<style>
/* ============================================================
   MetaMask — Transaction Database
   Ongoing 23h 45m transfer · escrow -> connected wallet
   ============================================================ */

:root{
  --brand:#f6851b; --brand-600:#e2761b;
  --blue:#4d6bfe; --violet:#8b5cf6; --green:#22c55e; --red:#ef4444;
  --amber:#f59e0b; --cyan:#06b6d4; --usdt:#26A17B;
  --shell:1320px; --header-h:66px; --footer-h:64px;
  --r-xs:8px; --r-sm:12px; --r-md:16px; --r-lg:22px; --r-xl:30px;
  --ease:cubic-bezier(.22,.61,.36,1);
  --font:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
}

:root[data-theme="dark"]{
  --bg:#08080b; --bg-2:#0d0d12; --surface:#121218; --surface-2:#17171f; --surface-3:#1c1c25;
  --border:#26262f; --border-soft:#1d1d25;
  --text:#ffffff; --text-2:#b7b7c2; --text-3:#7d7d8c;
  --ghost:rgba(255,255,255,.05); --ghost-h:rgba(255,255,255,.10);
  --shadow-sm:0 1px 2px rgba(0,0,0,.5);
  --shadow-md:0 10px 30px -12px rgba(0,0,0,.75);
  --shadow-lg:0 30px 70px -25px rgba(0,0,0,.85);
  --green-bg:rgba(34,197,94,.14); --red-bg:rgba(239,68,68,.14);
  --amber-bg:rgba(245,158,11,.14); --brand-bg:rgba(246,133,27,.14);
  --blue-bg:rgba(77,107,254,.14);
  --orb-a:rgba(246,133,27,.18); --orb-b:rgba(77,107,254,.16);
}

:root[data-theme="light"]{
  --bg:#ffffff; --bg-2:#f7f7fa; --surface:#ffffff; --surface-2:#fafafc; --surface-3:#f2f2f7;
  --border:#e4e4ec; --border-soft:#eeeef4;
  --text:#0d0d10; --text-2:#41414d; --text-3:#6b6b7b;
  --ghost:rgba(13,13,16,.05); --ghost-h:rgba(13,13,16,.10);
  --shadow-sm:0 1px 2px rgba(16,16,24,.06);
  --shadow-md:0 10px 30px -14px rgba(16,16,24,.22);
  --shadow-lg:0 30px 70px -28px rgba(16,16,24,.28);
  --green-bg:rgba(34,197,94,.12); --red-bg:rgba(239,68,68,.10);
  --amber-bg:rgba(245,158,11,.12); --brand-bg:rgba(246,133,27,.11);
  --blue-bg:rgba(77,107,254,.10);
  --orb-a:rgba(246,133,27,.14); --orb-b:rgba(77,107,254,.12);
}

/* ---------- BASE ---------- */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;font-family:var(--font);background:var(--bg);color:var(--text);
  line-height:1.55;font-weight:500;-webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;overflow-x:hidden;
  transition:background .3s var(--ease),color .3s var(--ease);
  padding-bottom:calc(var(--footer-h) + env(safe-area-inset-bottom) + 10px);
}
body.no-scroll{overflow:hidden}
h1,h2,h3,h4{margin:0;font-weight:800;letter-spacing:-.025em;line-height:1.15;color:var(--text)}
p{margin:0}
a{color:inherit;text-decoration:none}
button,input{font-family:inherit}
code{font-family:var(--mono)}
.shell{width:100%;max-width:var(--shell);margin-inline:auto;padding-inline:24px}
.ico{width:18px;height:18px;flex:0 0 auto;display:block}
.svg-defs{position:absolute;width:0;height:0;overflow:hidden}
[hidden]{display:none!important}

/* ---------- BACKGROUND ---------- */
.bg-orbs{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(100px)}
.orb-a{width:620px;height:620px;background:var(--orb-a);top:-220px;left:-160px}
.orb-b{width:680px;height:680px;background:var(--orb-b);top:120px;right:-260px}
.grid-veil{
  position:absolute;inset:0;
  background-image:linear-gradient(to right,var(--border-soft) 1px,transparent 1px),
                   linear-gradient(to bottom,var(--border-soft) 1px,transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(ellipse 85% 60% at 50% 0%,#000 15%,transparent 78%);
  -webkit-mask-image:radial-gradient(ellipse 85% 60% at 50% 0%,#000 15%,transparent 78%);
  opacity:.5;
}
header,main{position:relative;z-index:1}

/* ---------- HEADER ---------- */
.site-header{
  position:sticky;top:0;z-index:60;height:var(--header-h);
  backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
  background:color-mix(in srgb,var(--bg) 84%,transparent);
  border-bottom:1px solid var(--border);
}
.nav-inner{max-width:var(--shell);margin-inline:auto;padding-inline:24px;height:100%;display:flex;align-items:center;gap:14px}
.brand{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:15px;white-space:nowrap;color:var(--text)}
.brand-fox{width:28px;height:28px;flex:0 0 auto}
.brand em{font-style:normal;color:var(--brand)}
.brand small{
  font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  padding:3px 7px;border-radius:5px;background:var(--brand-bg);color:var(--brand);
  margin-left:2px;
}
.nav-spacer{margin-left:auto}
.nav-right{display:flex;align-items:center;gap:9px}

.icon-btn{
  width:38px;height:38px;display:grid;place-items:center;border-radius:var(--r-xs);
  border:1px solid var(--border);background:var(--surface);color:var(--text);
  cursor:pointer;transition:background .18s,transform .18s,border-color .18s;
}
.icon-btn:hover{background:var(--ghost-h);transform:translateY(-1px)}
.icon-btn .ico{width:18px;height:18px}
:root[data-theme="dark"] .ico-sun{display:none}
:root[data-theme="light"] .ico-moon{display:none}

.acct-chip{
  display:inline-flex;align-items:center;gap:8px;padding:7px 13px 7px 9px;
  border-radius:999px;border:1px solid var(--border);background:var(--surface);
  font-size:12.5px;font-weight:800;cursor:pointer;color:var(--text);
  transition:border-color .18s,background .18s;
}
.acct-chip:hover{border-color:color-mix(in srgb,var(--brand) 45%,var(--border));background:var(--ghost)}
.acct-chip .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(34,197,94,.18)}
.acct-chip code{font-size:11.5px;font-weight:700;color:var(--text-2)}

/* ---------- BUTTONS ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:11px 20px;border-radius:999px;border:1px solid transparent;
  font-size:14px;font-weight:800;letter-spacing:-.01em;cursor:pointer;white-space:nowrap;
  transition:transform .16s var(--ease),background .2s,box-shadow .2s,border-color .2s,opacity .2s;
  -webkit-tap-highlight-color:transparent;
}
.btn:active{transform:scale(.975)}
.btn .ico{width:17px;height:17px}
.btn-primary{background:var(--brand);color:#fff;box-shadow:0 8px 22px -10px rgba(246,133,27,.85)}
.btn-primary:hover{background:var(--brand-600);transform:translateY(-1px);box-shadow:0 12px 28px -10px rgba(246,133,27,.95)}
.btn-green{background:var(--green);color:#fff;box-shadow:0 8px 22px -10px rgba(34,197,94,.85)}
.btn-green:hover{background:#16a34a;transform:translateY(-1px)}
.btn-outline{background:transparent;color:var(--text);border-color:var(--border)}
.btn-outline:hover{background:var(--ghost);border-color:var(--text-3)}
.btn-lg{padding:14px 26px;font-size:15px}
.btn-lg .ico{width:18px;height:18px}
.btn-block{width:100%}

/* ---------- LAYOUT ---------- */
.db-wrap{display:grid;grid-template-columns:236px 1fr;gap:26px;padding:26px 0 54px;align-items:start}

/* ---------- SIDEBAR ---------- */
.sidebar{position:sticky;top:92px;display:grid;gap:16px}
.side-nav{display:grid;gap:2px}
.snav{
  display:flex;align-items:center;gap:11px;padding:10px 13px;border-radius:var(--r-xs);
  font-size:13.5px;font-weight:700;color:var(--text-2);cursor:pointer;
  transition:background .18s,color .18s;border:1px solid transparent;
}
.snav:hover{background:var(--ghost);color:var(--text)}
.snav.on{background:var(--brand-bg);color:var(--brand);border-color:color-mix(in srgb,var(--brand) 22%,transparent)}
.snav .ico{width:17px;height:17px}
.snav .count{
  margin-left:auto;font-size:10.5px;font-weight:800;padding:2px 7px;border-radius:999px;
  background:var(--surface-3);color:var(--text-3);border:1px solid var(--border);
}
.snav.on .count{background:var(--brand);color:#fff;border-color:transparent}

.side-box{
  padding:16px;border-radius:var(--r-md);border:1px solid var(--border);
  background:var(--surface);box-shadow:var(--shadow-sm);
}
.side-box h4{
  font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--text-3);margin-bottom:12px;
}
.mini-row{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:var(--text-2);padding:5px 0}
.mini-row i{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
.mini-row b{margin-left:auto;color:var(--text);font-weight:800;font-family:var(--mono);font-size:11.5px}

/* ---------- STAT STRIP ---------- */
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.stat-box{
  padding:16px;border-radius:var(--r-md);border:1px solid var(--border);
  background:var(--surface);box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
}
.stat-box::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:2.5px;
  background:var(--brand);opacity:.85;
}
.stat-box.green::before{background:var(--green)}
.stat-box.amber::before{background:var(--amber)}
.stat-box.blue::before{background:var(--blue)}
.stat-k{
  font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;
  color:var(--text-3);margin-bottom:6px;
}
.stat-v{
  font-size:clamp(17px,2vw,22px);font-weight:900;letter-spacing:-.03em;
  color:var(--text);line-height:1.1;font-variant-numeric:tabular-nums;
}
.stat-v.mono{font-family:var(--mono);font-size:clamp(15px,1.8vw,19px)}
.stat-v.green{color:var(--green)}
.stat-v.amber{color:var(--amber)}

/* ---------- ONGOING TRANSACTION HERO ---------- */
.tx-hero{
  border-radius:var(--r-xl);border:1px solid var(--border);
  background:
    radial-gradient(700px 300px at 6% 0%,rgba(246,133,27,.16),transparent 66%),
    radial-gradient(700px 300px at 94% 100%,rgba(77,107,254,.13),transparent 66%),
    var(--surface);
  box-shadow:var(--shadow-md);padding:30px;margin-bottom:18px;position:relative;overflow:hidden;
  transition:border-color .4s var(--ease),background .4s var(--ease);
}
.tx-hero.is-done{
  border-color:color-mix(in srgb,var(--green) 50%,var(--border));
  background:
    radial-gradient(700px 300px at 6% 0%,rgba(34,197,94,.17),transparent 66%),
    radial-gradient(700px 300px at 94% 100%,rgba(77,107,254,.10),transparent 66%),
    var(--surface);
}
.tx-hero::after{
  content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(115deg,transparent 44%,rgba(246,133,27,.045) 50%,transparent 56%);
}

.hero-top{display:flex;align-items:flex-start;gap:34px;flex-wrap:wrap;position:relative;z-index:1}

/* ring */
.ring-wrap{position:relative;width:196px;height:196px;flex:0 0 auto;margin-inline:auto}
.ring-svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring-track{fill:none;stroke:var(--border);stroke-width:9}
.ring-prog{
  fill:none;stroke:url(#ringGrad);stroke-width:9;stroke-linecap:round;
  transition:stroke-dashoffset .9s linear;
}
.ring-center{
  position:absolute;inset:0;display:grid;place-content:center;gap:3px;text-align:center;
  padding:0 16px;
}
.ring-digits{
  font-family:var(--mono);font-size:22px;font-weight:900;letter-spacing:-.04em;
  color:var(--text);line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;
}
.ring-digits.done{color:var(--green)}
.ring-cap{
  font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text-3);
}
.ring-check{display:grid;place-items:center;color:var(--green)}
.ring-check svg{width:52px;height:52px}

/* hero copy */
.hero-copy{flex:1;min-width:280px;position:relative;z-index:1}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--brand);margin-bottom:11px;
}
.eyebrow.is-done{color:var(--green)}
.eyebrow .pulse{
  width:7px;height:7px;border-radius:50%;background:var(--amber);
  box-shadow:0 0 0 4px rgba(245,158,11,.18);animation:pulse 2s infinite;
}
.eyebrow.is-done .pulse{background:var(--green);box-shadow:0 0 0 4px rgba(34,197,94,.18)}
@keyframes pulse{0%,100%{box-shadow:0 0 0 4px rgba(245,158,11,.18)}50%{box-shadow:0 0 0 9px rgba(245,158,11,.03)}}

.hero-title{font-size:clamp(21px,2.8vw,29px);font-weight:900;letter-spacing:-.035em;margin-bottom:9px}
.hero-desc{font-size:14px;font-weight:500;color:var(--text-2);line-height:1.62;margin-bottom:18px;max-width:520px}

.hero-amount{
  display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-bottom:16px;
}
.hero-amount .big{
  font-size:clamp(28px,4vw,40px);font-weight:900;letter-spacing:-.045em;
  line-height:1;color:var(--text);font-variant-numeric:tabular-nums;
}
.hero-amount .sym{
  font-size:13px;font-weight:900;letter-spacing:.04em;color:var(--usdt);
  padding:3px 9px;border-radius:6px;background:rgba(38,161,123,.13);
}
.hero-amount .usd{font-size:13px;font-weight:700;color:var(--text-3)}

/* progress */
.prog-wrap{margin-bottom:14px}
.prog-bar{height:8px;border-radius:999px;background:var(--border);overflow:hidden}
.prog-fill{
  display:block;height:100%;width:0;border-radius:999px;
  background:linear-gradient(90deg,var(--brand),#ffb066);
  transition:width .9s linear;
}
.prog-fill.done{background:linear-gradient(90deg,#16a34a,var(--green))}
.prog-meta{
  display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;
  margin-top:9px;font-size:11.5px;font-weight:700;color:var(--text-3);
}
.prog-meta b{color:var(--brand);font-weight:800}
.prog-meta b.done{color:var(--green)}

/* ---------- STAGE STEPS ---------- */
.stages{
  display:grid;grid-template-columns:repeat(4,1fr);gap:0;
  margin-top:24px;padding-top:22px;border-top:1px solid var(--border);
  position:relative;z-index:1;
}
.stage{position:relative;padding-right:12px;min-width:0}
.stage::before{
  content:"";position:absolute;top:11px;left:26px;right:-4px;height:2px;
  background:var(--border);z-index:0;
}
.stage:last-child::before{display:none}
.stage-dot{
  position:relative;z-index:1;width:24px;height:24px;border-radius:50%;
  display:grid;place-items:center;background:var(--surface-3);
  border:1.5px solid var(--border);color:var(--text-3);margin-bottom:9px;
  transition:background .3s,border-color .3s,color .3s;
}
.stage-dot .ico{width:12px;height:12px}
.stage.done .stage-dot{background:var(--green);border-color:var(--green);color:#fff}
.stage.active .stage-dot{
  background:var(--brand);border-color:var(--brand);color:#fff;
  box-shadow:0 0 0 4px rgba(246,133,27,.16);
}
.stage-label{font-size:11.5px;font-weight:800;color:var(--text-3);letter-spacing:-.01em}
.stage.active .stage-label{color:var(--brand)}
.stage.done .stage-label{color:var(--text)}

/* ---------- AMOUNT SPLIT ---------- */
.split-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:stretch;margin-bottom:18px}
.amt-card{
  padding:22px;border-radius:var(--r-lg);border:1px solid var(--border);
  background:var(--surface);box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
  transition:border-color .35s var(--ease),background .35s var(--ease);
}
.amt-card.escrow{border-color:color-mix(in srgb,var(--amber) 40%,var(--border))}
.amt-card.wallet{border-color:color-mix(in srgb,var(--green) 40%,var(--border))}
.amt-card.wallet.full{background:linear-gradient(135deg,var(--green-bg),transparent 62%),var(--surface)}

.amt-head{display:flex;align-items:center;gap:9px;margin-bottom:14px}
.amt-badge{
  width:32px;height:32px;border-radius:9px;display:grid;place-items:center;flex:0 0 auto;
}
.amt-badge .ico{width:16px;height:16px}
.amt-badge.amber{background:var(--amber-bg);color:var(--amber);border:1px solid color-mix(in srgb,var(--amber) 32%,transparent)}
.amt-badge.green{background:var(--green-bg);color:var(--green);border:1px solid color-mix(in srgb,var(--green) 32%,transparent)}
.amt-title{font-size:11.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--text-3)}
.amt-sub{font-size:11px;font-weight:700;color:var(--text-3);opacity:.85}

.amt-value{
  font-size:clamp(24px,3.2vw,32px);font-weight:900;letter-spacing:-.04em;
  line-height:1.05;font-variant-numeric:tabular-nums;color:var(--text);
  margin-bottom:5px;transition:color .3s;
}
.amt-card.escrow .amt-value{color:var(--amber)}
.amt-card.wallet .amt-value{color:var(--green)}
.amt-value small{font-size:.45em;font-weight:800;letter-spacing:0;opacity:.75;margin-left:4px}
.amt-usd{font-size:12px;font-weight:700;color:var(--text-3)}

.amt-bar{height:4px;border-radius:999px;background:var(--border);overflow:hidden;margin-top:14px}
.amt-bar i{display:block;height:100%;width:0;border-radius:999px;transition:width .9s linear}
.amt-card.escrow .amt-bar i{background:linear-gradient(90deg,var(--amber),#fbbf24)}
.amt-card.wallet .amt-bar i{background:linear-gradient(90deg,#16a34a,var(--green))}

.split-arrow{
  display:grid;place-items:center;width:44px;color:var(--text-3);flex:0 0 auto;
}
.split-arrow svg{width:26px;height:26px}

/* ---------- CARD ---------- */
.card{
  border-radius:var(--r-lg);border:1px solid var(--border);background:var(--surface);
  box-shadow:var(--shadow-sm);padding:22px;margin-bottom:18px;
}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}
.card-head h3{font-size:15px;font-weight:800;display:flex;align-items:center;gap:9px;letter-spacing:-.02em}
.card-head h3 .ico{width:17px;height:17px;color:var(--brand)}
.card-meta{font-size:11.5px;font-weight:700;color:var(--text-3)}

/* ---------- DETAIL GRID ---------- */
.dgrid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:15px;
}
.ditem{display:grid;gap:3px;min-width:0}
.ditem .k{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--text-3)}
.ditem .v{font-size:13px;font-weight:800;color:var(--text);word-break:break-all;line-height:1.45}
.ditem .v.mono{font-family:var(--mono);font-size:11.5px}
.ditem .v.green{color:var(--green)}
.ditem .v.amber{color:var(--amber)}
.ditem .v.red{color:var(--red)}

/* ---------- ASSET ROW ---------- */
.asset-row{
  display:flex;align-items:center;gap:13px;padding:13px 4px;
  border-bottom:1px solid var(--border);border-radius:var(--r-xs);transition:background .15s;
}
.asset-row:last-child{border-bottom:0}
.asset-row:hover{background:var(--ghost)}
.asset-logo{
  width:40px;height:40px;border-radius:50%;display:grid;place-items:center;
  flex:0 0 auto;overflow:hidden;position:relative;background:var(--surface-3);
}
.asset-logo img{width:100%;height:100%;object-fit:cover;display:block}
.asset-logo.dim{opacity:.55}
.asset-info{flex:1;min-width:0}
.asset-name{font-size:14px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.asset-sym{font-size:11.5px;font-weight:600;color:var(--text-3)}
.asset-val{text-align:right;flex:0 0 auto}
.asset-val b{display:block;font-size:14px;font-weight:800;font-variant-numeric:tabular-nums}
.asset-val span{display:block;font-size:11.5px;font-weight:700}
.up{color:var(--green)}.down{color:var(--red)}.pend{color:var(--amber)}

/* ---------- TX LIST ---------- */
.tx-row{
  display:flex;align-items:center;gap:12px;padding:13px 4px;
  border-bottom:1px solid var(--border);border-radius:var(--r-xs);transition:background .15s;
}
.tx-row:last-child{border-bottom:0}
.tx-row:hover{background:var(--ghost)}
.tx-ic{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;color:#fff;flex:0 0 auto}
.tx-ic .ico{width:17px;height:17px}
.tx-body{flex:1;min-width:0}
.tx-body b{display:block;font-size:13.5px;font-weight:800}
.tx-body span{display:block;font-size:11.5px;font-weight:600;color:var(--text-3)}
.tx-amt{text-align:right;flex:0 0 auto;display:grid;gap:3px;justify-items:end}
.tx-amt b{font-size:13.5px;font-weight:800;font-variant-numeric:tabular-nums}
.tx-amt span{font-size:11px;font-weight:700;color:var(--text-3)}

/* ---------- STATUS PILL ---------- */
.status-pill{
  display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;
  font-size:10px;font-weight:800;letter-spacing:.045em;text-transform:uppercase;white-space:nowrap;
}
.st-success{background:var(--green-bg);color:var(--green)}
.st-pending{background:var(--amber-bg);color:var(--amber)}
.st-processing{background:var(--blue-bg);color:var(--blue)}

/* ---------- BANNER ---------- */
.banner{
  display:flex;align-items:flex-start;gap:11px;padding:14px 16px;border-radius:var(--r-sm);
  background:var(--amber-bg);border:1px solid color-mix(in srgb,var(--amber) 32%,var(--border));
  font-size:12.5px;font-weight:600;color:var(--text-2);line-height:1.55;margin-bottom:18px;
}
.banner .ico{width:17px;height:17px;color:var(--amber);flex:0 0 auto;margin-top:1px}
.banner b{color:var(--text);font-weight:800}
.banner.is-done{
  background:var(--green-bg);border-color:color-mix(in srgb,var(--green) 34%,var(--border));
}
.banner.is-done .ico{color:var(--green)}

/* ---------- BSCSCAN CTA ---------- */
.scan-cta{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:18px 20px;border-radius:var(--r-md);
  background:linear-gradient(120deg,var(--brand-bg),transparent 70%),var(--surface-2);
  border:1px solid color-mix(in srgb,var(--brand) 34%,var(--border));
  margin-bottom:18px;
}
.scan-cta .scan-ic{
  width:38px;height:38px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto;
  background:var(--surface);border:1px solid var(--border);color:var(--brand);
}
.scan-cta .scan-ic .ico{width:18px;height:18px}
.scan-cta .scan-txt{flex:1;min-width:170px}
.scan-cta .scan-txt b{display:block;font-size:13.5px;font-weight:800}
.scan-cta .scan-txt span{display:block;font-size:11.5px;font-weight:600;color:var(--text-3)}

/* ---------- FOOTER NAV ---------- */
.footer-nav{
  position:fixed;bottom:0;left:0;right:0;z-index:100;
  background:color-mix(in srgb,var(--bg) 94%,transparent);
  backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
  border-top:1px solid var(--border);
  padding:8px 0 calc(8px + env(safe-area-inset-bottom));
  box-shadow:0 -8px 30px -18px rgba(0,0,0,.4);
}
.fnav-scroll{
  display:flex;gap:5px;overflow-x:auto;scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch;scrollbar-width:none;padding-inline:18px;
  max-width:var(--shell);margin-inline:auto;
}
.fnav-scroll::-webkit-scrollbar{display:none}
.fnav-btn{
  flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;
  padding:9px 16px;border-radius:999px;border:1px solid transparent;
  font-size:12.5px;font-weight:800;color:var(--text-2);background:transparent;
  cursor:pointer;white-space:nowrap;transition:background .18s,color .18s;
}
.fnav-btn .ico{width:16px;height:16px}
.fnav-btn:hover{background:var(--ghost);color:var(--text)}
.fnav-btn.on{background:var(--brand);color:#fff;box-shadow:0 6px 18px -8px rgba(246,133,27,.9)}

/* ---------- TOAST ---------- */
.toast{
  position:fixed;left:50%;bottom:calc(var(--footer-h) + env(safe-area-inset-bottom) + 20px);
  transform:translate(-50%,20px);z-index:300;display:inline-flex;align-items:center;gap:9px;
  padding:12px 18px;border-radius:999px;background:var(--surface);border:1px solid var(--border);
  box-shadow:var(--shadow-lg);font-size:13px;font-weight:800;color:var(--text);
  opacity:0;pointer-events:none;transition:opacity .25s var(--ease),transform .25s var(--ease);max-width:90vw;
}
.toast.is-on{opacity:1;transform:translate(-50%,0)}
.toast .ico{width:16px;height:16px;color:var(--brand)}

/* ---------- OVERLAY (BscScan redirect) ---------- */
.overlay{
  position:fixed;inset:0;z-index:500;display:grid;place-items:center;padding:22px;
  background:rgba(4,4,8,.78);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  animation:fadeIn .22s var(--ease);
}
.overlay[hidden]{display:none}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes riseIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
.modal{
  position:relative;width:100%;max-width:420px;border-radius:var(--r-xl);
  background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadow-lg);
  padding:32px 26px 24px;animation:riseIn .3s var(--ease);text-align:center;
}
.modal-ic{
  width:62px;height:62px;border-radius:18px;display:grid;place-items:center;margin:0 auto 18px;
  background:var(--green-bg);border:1px solid color-mix(in srgb,var(--green) 36%,transparent);color:var(--green);
}
.modal-ic .ico{width:30px;height:30px}
.modal h2{font-size:20px;font-weight:900;letter-spacing:-.03em;margin-bottom:8px}
.modal p{font-size:13.5px;font-weight:500;color:var(--text-2);line-height:1.6;margin-bottom:20px}
.modal .spin{
  width:26px;height:26px;border:2.5px solid var(--border);border-top-color:var(--brand);
  border-radius:50%;margin:0 auto 16px;animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- RESPONSIVE ---------- */
@media (max-width:1080px){
  .db-wrap{grid-template-columns:1fr;gap:18px}
  .sidebar{position:static;grid-template-columns:1fr}
  .side-nav{
    display:flex;overflow-x:auto;gap:5px;scrollbar-width:none;
    -webkit-overflow-scrolling:touch;padding-bottom:4px;
  }
  .side-nav::-webkit-scrollbar{display:none}
  .snav{white-space:nowrap;flex:0 0 auto;border:1px solid var(--border);background:var(--surface)}
  .snav .count{display:none}
  .stat-strip{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:860px){
  .tx-hero{padding:24px}
  .hero-top{gap:26px}
  .ring-wrap{width:172px;height:172px}
  .ring-digits{font-size:19px}
  .stages{grid-template-columns:repeat(2,1fr);gap:16px 0}
  .stage:nth-child(2)::before{display:none}
  .split-grid{grid-template-columns:1fr}
  .split-arrow{transform:rotate(90deg);height:34px;width:100%;justify-items:center}
}
@media (max-width:640px){
  .shell{padding-inline:15px}
  .nav-inner{padding-inline:15px;gap:9px}
  .brand span{display:none}
  .brand small{display:none}
  .acct-chip{padding:6px 10px 6px 8px}
  .acct-chip code{display:none}
  .acct-chip::after{content:"0xfe46…c373";font-size:11px;font-weight:800;color:var(--text-2)}
  .db-wrap{padding:18px 0 42px}
  .stat-strip{grid-template-columns:repeat(2,1fr);gap:9px}
  .stat-box{padding:13px}
  .stat-k{font-size:9.5px}
  .tx-hero{padding:20px 16px;border-radius:var(--r-lg)}
  .ring-wrap{width:150px;height:150px}
  .ring-digits{font-size:17px}
  .ring-cap{font-size:8.5px}
  .hero-title{font-size:20px}
  .hero-desc{font-size:13px}
  .hero-amount .big{font-size:28px}
  .amt-card{padding:18px;border-radius:var(--r-md)}
  .amt-value{font-size:26px}
  .card{padding:18px 15px;border-radius:var(--r-md);margin-bottom:14px}
  .card-head h3{font-size:14px}
  .dgrid{grid-template-columns:1fr;gap:12px}
  .asset-row{padding:11px 2px;gap:10px}
  .asset-logo{width:36px;height:36px}
  .asset-name{font-size:13px}
  .asset-val b{font-size:13px}
  .tx-row{padding:11px 2px;gap:10px}
  .tx-ic{width:32px;height:32px;border-radius:9px}
  .tx-body b{font-size:13px}
  .tx-body span{font-size:11px}
  .tx-amt b{font-size:13px}
  .banner{font-size:12px;padding:12px 14px}
  .scan-cta{padding:15px;gap:11px}
  .scan-cta .scan-txt b{font-size:13px}
  .fnav-scroll{padding-inline:13px}
  .fnav-btn{padding:8px 13px;font-size:11.5px}
  .modal{padding:26px 20px 20px}
  .toast{font-size:12px;padding:10px 15px;bottom:calc(var(--footer-h) + env(safe-area-inset-bottom) + 14px)}
}
@media (max-width:400px){
  .stat-strip{grid-template-columns:1fr 1fr}
  .ring-wrap{width:136px;height:136px}
  .ring-digits{font-size:15px}
  .hero-amount .big{font-size:25px}
  .amt-value{font-size:23px}
  .fnav-btn{padding:8px 11px}
  .fnav-btn span{display:none}
  .fnav-btn .ico{width:17px;height:17px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
</head>
